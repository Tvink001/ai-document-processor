  "nodes": [
    { "id": "node-wf03-trigger", "name": "When called by WF02", "type": "n8n-nodes-base.executeWorkflowTrigger", "typeVersion": 1.1, "position": [200, 300], "parameters": { "inputSource": "passthrough" } },
    { "id": "node-expand-results", "name": "Expand Results", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [440, 300], "parameters": { "mode": "runOnceForAllItems", "jsCode": "// WF03 step 1 — expand WF02's results[] into N items, one per file.\nconst inp = $input.first() && $input.first().json;\nif (!inp) return [];\nconst results = inp.results || [];\nreturn results.map(r => ({ json: r }));" } },
    { "id": "node-tg-download-for-drive", "name": "Telegram: Re-Download for Drive", "type": "n8n-nodes-base.telegram", "typeVersion": 1.2, "position": [680, 300], "parameters": { "resource": "file", "operation": "get", "fileId": "={{ $json.file_id }}", "download": true, "additionalFields": {} }, "credentials": { "telegramApi": { "id": "awqlBtw3tG6HJGW1", "name": "Telegram account 2" } }, "onError": "continueRegularOutput" },
    { "id": "node-compute-md5", "name": "Compute MD5", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [920, 300], "parameters": { "mode": "runOnceForEachItem", "jsCode": "// WF03 — md5 of binary CONTENT. Pull original file metadata from Expand Results\n// (Telegram Re-Download's output replaces $json with {ok, result}, dropping our fields).\nconst crypto = require('crypto');\nconst meta = $('Expand Results').item.json;\nlet hash = '';\nlet fsize = 0;\ntry {\n  if ($binary && $binary.data) {\n    const buffer = await this.helpers.getBinaryDataBuffer($itemIndex, 'data');\n    hash = crypto.createHash('md5').update(buffer).digest('hex');\n    fsize = ($binary.data.bytes && Number($binary.data.bytes)) || buffer.length;\n  } else {\n    const fuid = meta.file_unique_id || '';\n    hash = crypto.createHash('md5').update(fuid + '_no_binary').digest('hex');\n  }\n} catch (e) {\n  hash = 'md5_compute_failed';\n}\nreturn { json: { ...meta, file_md5: hash, file_size: fsize }, binary: $binary };" } },
    { "id": "node-read-docs-by-md5", "name": "Read Documents by MD5", "type": "n8n-nodes-base.googleSheets", "typeVersion": 4.7, "position": [1160, 300], "parameters": { "documentId": { "__rl": true, "mode": "id", "value": "1tl3rvKeaMrreDfjQMQQPlZF6hGYbG-h0Ft4BroPRw_w", "cachedResultName": "P3_bot Sheet" }, "sheetName": { "__rl": true, "mode": "name", "value": "documents", "cachedResultName": "documents" }, "filtersUI": { "values": [{ "lookupColumn": "file_md5", "lookupValue": "={{ $json.file_md5 }}" }] }, "options": { "returnFirstMatch": false } }, "credentials": { "googleSheetsOAuth2Api": { "id": "vPYba8prk7sfff5g", "name": "Google Sheets account" } }, "onError": "continueRegularOutput", "alwaysOutputData": true },
    { "id": "node-check-dedup", "name": "Check Dedup", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [1400, 300], "parameters": { "mode": "runOnceForAllItems", "jsCode": "// WF03 — pair Sheets-read matches back to our N file items, preserve binary.\nconst sheetRows = $input.all().map(i => i.json);\nconst fileItems = $('Compute MD5').all();\n\nconst byMd5 = {};\nfor (const r of sheetRows) {\n  if (r && r.file_md5) {\n    (byMd5[r.file_md5] = byMd5[r.file_md5] || []).push(r);\n  }\n}\n\nreturn fileItems.map(f => {\n  const matches = byMd5[f.json.file_md5] || [];\n  const dedup_hit = matches.length > 0;\n  const existing = dedup_hit ? matches[0] : null;\n  return {\n    json: { ...f.json, dedup_hit, existing_drive_url: existing ? existing.drive_url : null, existing_detected_type: existing ? existing.detected_type : null },\n    binary: f.binary\n  };\n});" } },
    { "id": "node-if-dedup", "name": "IF dedup_hit?", "type": "n8n-nodes-base.if", "typeVersion": 2.3, "position": [1640, 300], "parameters": { "conditions": { "options": { "version": 2, "leftValue": "", "caseSensitive": true, "typeValidation": "loose" }, "combinator": "and", "conditions": [{ "id": "rule-dedup", "leftValue": "={{ $json.dedup_hit }}", "rightValue": "", "operator": { "type": "boolean", "operation": "true", "singleValue": true } }] }, "options": {} } },
    { "id": "node-carry-over", "name": "Carry Over (dedup hit)", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [1880, 180], "parameters": { "mode": "runOnceForEachItem", "jsCode": "// WF03 dedup hit — reuse existing drive_url, mark for documents append.\nreturn { json: { ...$json, drive_url: $json.existing_drive_url, drive_skipped: true, processed_at: new Date().toISOString() } };" } },
    { "id": "node-build-filename", "name": "Build Filename", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [1880, 420], "parameters": { "mode": "runOnceForEachItem", "jsCode": "// WF03 — compose drive filename. CRITICAL: preserve $binary for Drive Upload downstream.\nconst meta = $('Check Dedup').item.json;\nconst date = meta.date || 'nodate';\nconst type = meta.detected_type || 'unknown';\nconst num = meta.number || (meta.file_id ? String(meta.file_id).slice(-8) : 'noid');\nconst mime = meta.mime_type || '';\nlet ext = 'bin';\nif (mime === 'application/pdf') ext = 'pdf';\nelse if (mime.indexOf('wordprocessingml') !== -1) ext = 'docx';\nelse if (mime === 'image/jpeg') ext = 'jpg';\nelse if (mime === 'image/png') ext = 'png';\nconst raw = `${date}_${type}_${num}.${ext}`;\nconst safe = raw.replace(/[^A-Za-z0-9._\\-]/g, '_');\nreturn { json: { ...$json, filename: safe, _meta_passthrough: meta }, binary: $binary };" } },
    { "id": "node-drive-upload", "name": "Drive: Upload", "type": "n8n-nodes-base.googleDrive", "typeVersion": 3, "position": [2120, 420], "parameters": { "resource": "file", "operation": "upload", "name": "={{ $json.filename }}", "inputDataFieldName": "data", "driveId": { "__rl": true, "mode": "list", "value": "My Drive", "cachedResultName": "My Drive" }, "folderId": { "__rl": true, "mode": "id", "value": "1OvuG8ZTHlvF375Oj0GscdtH0nH8iadRU", "cachedResultName": "P3_bot Archive" }, "options": {} }, "credentials": { "googleDriveOAuth2Api": { "id": "WriOvqVONCdAUwWt", "name": "Google Drive account" } }, "onError": "continueRegularOutput" },
    { "id": "node-build-new-row", "name": "Build New Row (upload done)", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [2360, 420], "parameters": { "mode": "runOnceForEachItem", "jsCode": "// WF03 — take Drive upload response, attach drive_url, hand off to Sheets append.\nconst meta = $('Build Filename').item.json._meta_passthrough || $('Check Dedup').item.json;\nconst driveResp = $json;\nconst webViewLink = driveResp.webViewLink || (driveResp.id ? `https://drive.google.com/file/d/${driveResp.id}/view` : null);\nreturn { json: { ...meta, drive_url: webViewLink, drive_skipped: false, processed_at: new Date().toISOString() } };" } },
    { "id": "node-sheets-append-doc", "name": "Documents: Append or Update", "type": "n8n-nodes-base.googleSheets", "typeVersion": 4.7, "position": [2600, 300], "parameters": { "resource": "sheet", "operation": "appendOrUpdate", "documentId": { "__rl": true, "mode": "id", "value": "1tl3rvKeaMrreDfjQMQQPlZF6hGYbG-h0Ft4BroPRw_w", "cachedResultName": "P3_bot Sheet" }, "sheetName": { "__rl": true, "mode": "name", "value": "documents", "cachedResultName": "documents" }, "columns": { "mappingMode": "defineBelow", "matchingColumns": ["session_id", "file_id"], "value": { "session_id": "={{ $json.session_id }}", "file_id": "={{ $json.file_id }}", "file_name": "={{ $json.file_name }}", "file_md5": "={{ $json.file_md5 }}", "detected_type": "={{ $json.detected_type }}", "date": "={{ $json.date || '' }}", "number": "={{ $json.number || '' }}", "amount": "={{ $json.amount !== null && $json.amount !== undefined ? $json.amount : '' }}", "contractor": "={{ $json.contractor || '' }}", "confidence": "={{ $json.confidence }}", "model_used": "={{ $json.model_used || '' }}", "drive_url": "={{ $json.drive_url || '' }}", "processed_at": "={{ $json.processed_at }}" }, "schema": [{ "id": "session_id", "type": "string", "display": true, "displayName": "session_id", "defaultMatch": true, "canBeUsedToMatch": true }, { "id": "file_id", "type": "string", "display": true, "displayName": "file_id", "canBeUsedToMatch": true }, { "id": "file_name", "type": "string", "display": true, "displayName": "file_name" }, { "id": "file_md5", "type": "string", "display": true, "displayName": "file_md5" }, { "id": "detected_type", "type": "string", "display": true, "displayName": "detected_type" }, { "id": "date", "type": "string", "display": true, "displayName": "date" }, { "id": "number", "type": "string", "display": true, "displayName": "number" }, { "id": "amount", "type": "number", "display": true, "displayName": "amount" }, { "id": "contractor", "type": "string", "display": true, "displayName": "contractor" }, { "id": "confidence", "type": "number", "display": true, "displayName": "confidence" }, { "id": "model_used", "type": "string", "display": true, "displayName": "model_used" }, { "id": "drive_url", "type": "string", "display": true, "displayName": "drive_url" }, { "id": "processed_at", "type": "string", "display": true, "displayName": "processed_at" }] }, "options": {} }, "credentials": { "googleSheetsOAuth2Api": { "id": "vPYba8prk7sfff5g", "name": "Google Sheets account" } }, "onError": "continueRegularOutput" },
    { "id": "node-aggregate-docs", "name": "Aggregate Per Session", "type": "n8n-nodes-base.aggregate", "typeVersion": 1, "position": [2840, 300], "parameters": { "aggregate": "aggregateAllItemData", "destinationFieldName": "documents", "include": "allFields", "options": {} } },
    { "id": "node-sheets-update-session", "name": "Sessions: Update Status", "type": "n8n-nodes-base.googleSheets", "typeVersion": 4.7, "position": [3080, 300], "parameters": { "resource": "sheet", "operation": "update", "documentId": { "__rl": true, "mode": "id", "value": "1tl3rvKeaMrreDfjQMQQPlZF6hGYbG-h0Ft4BroPRw_w", "cachedResultName": "P3_bot Sheet" }, "sheetName": { "__rl": true, "mode": "name", "value": "sessions", "cachedResultName": "sessions" }, "columns": { "mappingMode": "defineBelow", "matchingColumns": ["session_id"], "value": { "session_id": "={{ $json.documents[0].session_id }}", "status": "archiving", "error_count": "={{ ($json.documents || []).filter(d => d.error).length }}" }, "schema": [{ "id": "session_id", "type": "string", "display": true, "displayName": "session_id", "defaultMatch": true, "canBeUsedToMatch": true }, { "id": "status", "type": "string", "display": true, "displayName": "status" }, { "id": "error_count", "type": "number", "display": true, "displayName": "error_count" }] }, "options": {} }, "credentials": { "googleSheetsOAuth2Api": { "id": "vPYba8prk7sfff5g", "name": "Google Sheets account" } }, "onError": "continueRegularOutput" },
