    {
      "id": "node-decide-leader",
      "name": "Decide Leader",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1300, 300],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// WF01 — interpret TRY LOCK response, set lock_won/degraded.\n// HTTP response shape: { result: 'OK' } when SET NX succeeded; { result: null } when key already exists.\n// With onError: continueRegularOutput, transport errors come through as { error: ... }.\nconst _passthrough = $json;\nconst tryLockResp = $('HTTP: TRY LOCK').first().json;\nconst meta = $('Compute Session ID').item.json;\nif (meta.skip) return { json: { ...meta, lock_won: false, degraded: false, skip: true } };\n\nlet lockWon = false;\nlet degraded = false;\nlet degradedReason = null;\n\nif (tryLockResp && tryLockResp.error) {\n  degraded = true;\n  degradedReason = 'try_lock_http_failed:' + JSON.stringify(tryLockResp.error).slice(0, 120);\n} else if (tryLockResp && tryLockResp.result === 'OK') {\n  lockWon = true;\n} else if (tryLockResp && (tryLockResp.result === null || tryLockResp.result === undefined)) {\n  lockWon = false;\n} else {\n  degraded = true;\n  degradedReason = 'try_lock_unexpected:' + JSON.stringify(tryLockResp).slice(0, 200);\n}\n\nreturn { json: { ...meta, lock_won: lockWon, degraded: degraded, degraded_reason: degradedReason } };"
      }
    },
