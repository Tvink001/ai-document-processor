      "name": "HTTP: TRY LOCK",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [1080, 300],
      "parameters": {
        "method": "POST",
        "url": "=https://settling-raccoon-132305.upstash.io/set/lock:{{ $('Compute Session ID').item.json.session_id }}/{{ $('Compute Session ID').item.json.file.file_unique_id }}/NX/EX/30",
