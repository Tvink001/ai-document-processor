    {
      "id": "wf01-normalize",
      "name": "Normalize Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [420, 300],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// WF01 — read the Python aiogram intake payload and enrich every file row\n// with the per-file metadata WF02b's Expand Statements expects.\nconst inp = $input.first().json;\nconst body = inp.body || inp;\nconst chat_id = body.chat_id;\nconst session_id = body.session_id;\nconst files = Array.isArray(body.files) ? body.files : [];\nconst target_folder_id = body.target_folder_id || '';\nconst target_folder_name = body.target_folder_name || '';\nconst model_tier = body.model_tier || 'haiku';\nconst callback_url = body.callback_url || '';\nconst user_id = body.user_id || chat_id;\nconst username = body.username || '';\nconst first_name = body.first_name || '';\nconst nowMs = Date.now();\nconst nowIso = new Date(nowMs).toISOString();\n\nconst enriched = files.map((f, idx) => ({\n  file_id: f.file_id,\n  file_unique_id: f.file_id,\n  file_name: f.file_name,\n  mime_type: f.mime_type || 'application/pdf',\n  file_size: f.file_size || 0,\n  page_count: f.page_count || 0,\n  session_id,\n  chat_id,\n  user_id,\n  username,\n  first_name,\n  message_id: nowMs + idx,\n  media_group_id: null,\n  received_at_ms: nowMs\n}));\n\nreturn [{\n  json: {\n    session_id,\n    chat_id,\n    user_id,\n    username,\n    first_name,\n    started_at: nowIso,\n    files: enriched,\n    files_count: enriched.length,\n    target_folder_id,\n    target_folder_name,\n    model_tier,\n    callback_url,\n    leader_file_unique_id: (enriched[0] && enriched[0].file_unique_id) || '',\n    leader_received_at_ms: nowMs\n  }\n}];"
      }
    },
    {
      "id": "wf01-switch",
      "name": "Switch: files > 6?",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.4,
      "position": [640, 300],
      "parameters": {
        "mode": "rules",
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "loose"
                },
                "conditions": [
                  {
                    "id": "rule-too-many",
                    "leftValue": "={{ ($json.files || []).length }}",
                    "rightValue": 6,
