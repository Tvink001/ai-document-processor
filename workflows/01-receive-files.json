    {
      "id": "node-drain",
      "name": "Drain",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1960, 300],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// WF01 — leader builds consolidated album payload; non-leader exits silently.\n// CRITICAL: by the time Drain runs, $json is the SMEMBERS HTTP response\n// ({result:[...]}). Each HTTP node replaces the current item with its response,\n// so previous fields (session_id, lock_won, degraded) are NOT on $json.\n// Read state from upstream nodes by name — never rely on $json field carryover.\nconst meta = $('Compute Session ID').item.json;\nif (meta.skip) return null;\n\nconst dec = $('Decide Leader').item.json;\nconst smembersResp = $('HTTP: SMEMBERS album').first().json;\n\nfunction singleFilePayload(reason) {\n  let oneFile;\n  try { oneFile = JSON.parse(meta.file_meta_json); }\n  catch (_) {\n    oneFile = {\n      session_id: meta.session_id,\n      chat_id: meta.chat_id,\n      user_id: meta.user_id,\n      username: meta.username,\n      message_id: meta.message_id,\n      media_group_id: meta.media_group_id,\n      started_at: meta.started_at,\n      received_at_ms: meta.received_at_ms,\n      file: meta.file\n    };\n  }\n  return { json: {\n    session_id: meta.session_id,\n    files: [oneFile],\n    files_count: 1,\n    leader_file_unique_id: (meta.file && meta.file.file_unique_id) || '',\n    leader_received_at_ms: meta.received_at_ms,\n    degraded: true,\n    degraded_reason: reason\n  }};\n}\n\nif (dec.degraded === true) return singleFilePayload(dec.degraded_reason || 'try_lock_failed');\n\nif (!dec.lock_won) return null;\n\nif (!smembersResp || smembersResp.error) {\n  const reason = 'smembers_http_failed:' + JSON.stringify((smembersResp && smembersResp.error) || 'no_response').slice(0, 120);\n  return singleFilePayload(reason);\n}\n\nconst members = (Array.isArray(smembersResp.result) ? smembersResp.result : []);\nconst files = [];\nfor (const m of members) {\n  try { files.push(JSON.parse(m)); } catch (_) {}\n}\n\nfiles.sort((a, b) => {\n  const dt = Number(a.received_at_ms || 0) - Number(b.received_at_ms || 0);\n  if (dt !== 0) return dt;\n  return String((a.file && a.file.file_unique_id) || '')\n    .localeCompare(String((b.file && b.file.file_unique_id) || ''));\n});\n\nif (files.length === 0) {\n  return singleFilePayload('smembers_empty_set');\n}\n\nconst leader = files[0] || {};\n\nreturn { json: {\n  session_id: meta.session_id,\n  files: files,\n  files_count: files.length,\n  leader_file_unique_id: (leader.file && leader.file.file_unique_id) || '',\n  leader_received_at_ms: leader.received_at_ms || meta.received_at_ms,\n  degraded: false\n}};"
      }
