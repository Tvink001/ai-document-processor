            }
          },
          "timeout": 10000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "2oRQsjg0OiMU7Eq3",
          "name": "X-Callback-Token"
        }
      },
      "retryOnFail": true,
