    {
      "id": "node-leader-decision",
      "name": "Leader Decision",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1400, 300],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// WF01 step 6 — leader election + album consolidation.\n// Each execution arrives here with the same set of buffer rows for its session.\n// Winner: row with min(received_at_ms), tie-break by file_unique_id ASC.\n// Only the winner returns a payload; others return [] and exit silently.\n\nconst myFile = ($('Compute Session ID').item && $('Compute Session ID').item.json) || {};\nconst mySessionId = myFile.session_id || '';\nconst myFileUniqueId = (myFile.file && myFile.file.file_unique_id) || '';\n\nconst rows = $input.all()\n  .map(i => i.json)\n  .filter(r => r && r.session_id === mySessionId)\n  .filter(r => String(r.processed) !== 'true');\n\nif (rows.length === 0) return [];\n\nrows.sort((a, b) => {\n  const dt = Number(a.received_at_ms) - Number(b.received_at_ms);\n  if (dt !== 0) return dt;\n  return String(a.file_unique_id).localeCompare(String(b.file_unique_id));\n});\n\nconst leader = rows[0];\nconst amILeader = String(leader.file_unique_id) === String(myFileUniqueId);\nif (!amILeader) return [];\n\n// I'm the leader. Build consolidated session payload.\nconst files = rows.map(r => {\n  try { return JSON.parse(r.file_meta_json || '{}'); }\n  catch (e) { return { file_meta_parse_error: true, raw: r.file_meta_json }; }\n});\n\nreturn [{ json: {\n  session_id: mySessionId,\n  files: files,\n  files_count: files.length,\n  leader_file_unique_id: leader.file_unique_id,\n  leader_received_at_ms: leader.received_at_ms\n}}];"
      }
    },
