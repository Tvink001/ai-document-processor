    {
      "id": "node-compute-session",
      "name": "Compute Session ID",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [440, 300],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// WF01 step 2 — derive session_id, normalize file metadata, stamp received_at_ms.\nconst msg = $json.message || $json;\nconst chatId = msg.chat && msg.chat.id;\nconst messageId = msg.message_id;\nconst mediaGroupId = msg.media_group_id || null;\nconst sessionId = `${chatId}_${mediaGroupId || messageId}`;\nconst nowMs = Date.now();\nconst nowIso = new Date(nowMs).toISOString();\n\nlet file = null;\nif (msg.document) {\n  file = {\n    file_id: msg.document.file_id,\n    file_unique_id: msg.document.file_unique_id,\n    file_name: msg.document.file_name || `doc_${messageId}`,\n    mime_type: msg.document.mime_type || 'application/octet-stream',\n    file_size: msg.document.file_size || 0\n  };\n} else if (Array.isArray(msg.photo) && msg.photo.length > 0) {\n  const largest = msg.photo[msg.photo.length - 1];\n  file = {\n    file_id: largest.file_id,\n    file_unique_id: largest.file_unique_id,\n    file_name: `photo_${messageId}.jpg`,\n    mime_type: 'image/jpeg',\n    file_size: largest.file_size || 0\n  };\n} else {\n  return { json: { skip: true, reason: 'no_document_or_photo' } };\n}\n\nreturn {\n  json: {\n    session_id: sessionId,\n    chat_id: chatId,\n    user_id: msg.from && msg.from.id,\n    username: (msg.from && msg.from.username) || null,\n    message_id: messageId,\n    media_group_id: mediaGroupId,\n    started_at: nowIso,\n    received_at_ms: nowMs,\n    received_at_iso: nowIso,\n    file,\n    file_meta_json: JSON.stringify({\n      session_id: sessionId,\n      chat_id: chatId,\n      user_id: msg.from && msg.from.id,\n      username: (msg.from && msg.from.username) || null,\n      message_id: messageId,\n      media_group_id: mediaGroupId,\n      started_at: nowIso,\n      file\n    })\n  }\n};"
      }
    },
