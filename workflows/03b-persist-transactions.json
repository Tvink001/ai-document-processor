    {
      "id": "node-expand-statements",
      "name": "Expand Statements",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [420, 300],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// WF03b step 1 — unpack statements[] from WF02b into N items, one per statement.\nconst inp = $input.first() && $input.first().json;\nif (!inp) return [];\nconst statements = (inp.statements || []);\nreturn statements.map(s => ({ json: s }));"
      }
    },
    {
      "id": "node-period-hash",
      "name": "Compute Period Hash + Filename",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [640, 300],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// WF03b step 2 — compute dedup_period_hash + the Drive filename.\nconst crypto = require('crypto');\nconst s = $json;\nconst bank = s.bank || 'generic';\nconst ps = s.period_start || 'nodate';\nconst pe = s.period_end || 'nodate';\nconst period_hash = crypto.createHash('md5').update(`${bank}|${ps}|${pe}`).digest('hex');\nconst sshort = (s.statement_id || '').slice(0, 8) || 'noid';\nconst rawName = `${bank}_${ps}_${pe}_${sshort}.pdf`;\nconst filename = rawName.replace(/[^A-Za-z0-9._\\-\\u0400-\\u04ff]/g, '_');\nreturn { json: { ...s, dedup_period_hash: period_hash, drive_filename: filename } };"
      }
    },
