    {
      "id": "node-expand-tx",
      "name": "Expand Transactions",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1740, 300],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// WF03b step 6 — flatten all statements' transactions into individual sheet rows.\nconst statementItems = $('Build Statement Row').all().map(i => i.json);\nconst rows = [];\nfor (const s of statementItems) {\n  const txs = Array.isArray(s.transactions) ? s.transactions : [];\n  for (const t of txs) {\n    rows.push({\n      json: {\n        session_id: s.session_id,\n        statement_id: s.statement_id,\n        date: t.date || '',\n        description: t.description || '',\n        counterparty: t.counterparty || '',\n        amount: typeof t.amount === 'number' ? t.amount : '',\n        currency: t.currency || s.currency || 'UAH',\n        debit_credit: t.debit_credit || '',\n        balance_after: typeof t.balance_after === 'number' ? t.balance_after : '',\n        category: t.category || 'other',\n        confidence: typeof t.confidence === 'number' ? t.confidence : 0,\n        model_used: t.model_used || 'haiku-4.5'\n      }\n    });\n  }\n}\nreturn rows;"
      }
    },
