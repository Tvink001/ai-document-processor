    {
      "id": "node-aggregate-session",
      "name": "Aggregate Session Update",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2180, 300],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// WF03b step 8 — aggregate per-session totals for the Sessions tab update.\nconst statementItems = $('Build Statement Row').all().map(i => i.json);\nif (statementItems.length === 0) return [];\nconst sessionId = statementItems[0].session_id;\nconst stmts = statementItems.length;\nconst txTotal = statementItems.reduce((sum, s) => sum + ((s.transactions || []).length), 0);\nconst lowConfTotal = statementItems.reduce((sum, s) => {\n  return sum + (s.transactions || []).filter(t => typeof t.confidence === 'number' && t.confidence < 0.8).length;\n}, 0);\nreturn [{ json: { session_id: sessionId, status: 'building_xlsx', statements_count: stmts, transactions_total: txTotal, low_confidence_count: lowConfTotal } }];"
      }
    },
