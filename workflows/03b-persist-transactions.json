    {
      "id": "node-build-row",
      "name": "Build Statement Row",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1300, 300],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// WF03b step 4 — assemble the statements-sheet row from Drive upload response + meta.\nconst driveResp = $json;\nconst meta = $('Compute Period Hash + Filename').item.json;\nconst webViewLink = driveResp.webViewLink || (driveResp.id ? `https://drive.google.com/file/d/${driveResp.id}/view` : null);\nreturn {\n  json: {\n    session_id: meta.session_id,\n    statement_id: meta.statement_id,\n    bank: meta.bank,\n    period_start: meta.period_start,\n    period_end: meta.period_end,\n    currency: meta.currency,\n    opening_balance: meta.opening_balance,\n    closing_balance: meta.closing_balance,\n    dedup_period_hash: meta.dedup_period_hash,\n    drive_url: webViewLink,\n    processed_at: new Date().toISOString(),\n    transactions: meta.transactions || []\n  }\n};"
      }
    },
