        [{ "node": "Image to Base64", "type": "main", "index": 0 }],
        [{ "node": "Mark Unsupported", "type": "main", "index": 0 }]
      ]
    },
    "Extract PDF Text": {
      "main": [[{ "node": "Normalize PDF", "type": "main", "index": 0 }]]
    },
    "DOCX to Base64": {
      "main": [[{ "node": "HTTP: Extract DOCX (Apps Script)", "type": "main", "index": 0 }]]
    },
    "HTTP: Extract DOCX (Apps Script)": {
      "main": [[{ "node": "Normalize DOCX", "type": "main", "index": 0 }]]
    },
    "Normalize PDF": {
      "main": [[{ "node": "Aggregate Results", "type": "main", "index": 0 }]]
    },
    "Normalize DOCX": {
      "main": [[{ "node": "Aggregate Results", "type": "main", "index": 0 }]]
    },
    "Image to Base64": {
      "main": [[{ "node": "Normalize Image", "type": "main", "index": 0 }]]
    },
    "Normalize Image": {
      "main": [[{ "node": "Aggregate Results", "type": "main", "index": 0 }]]
    },
    "Mark Unsupported": {
      "main": [[{ "node": "Aggregate Results", "type": "main", "index": 0 }]]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "tags": []
}
