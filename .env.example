# === Telegram ===
TELEGRAM_BOT_TOKEN=
OWNER_TELEGRAM_CHAT_ID=1410989113

# === n8n integration ===
# Set after M14 deploys the Webhook node. Full URL printed in n8n editor.
N8N_WEBHOOK_URL=https://onewinnerfourtytwoloosers.app.n8n.cloud/webhook/p3-process
# Same secret stored in n8n cred "X-Webhook-Secret" (id V9zB3wnC3M6BxyOY).
N8N_WEBHOOK_SECRET=
# Same secret stored in n8n cred "X-Callback-Token" (id 2oRQsjg0OiMU7Eq3).
CALLBACK_TOKEN=
# Public base URL n8n calls back on. ngrok in dev, fly.io app URL in prod.
CALLBACK_BASE_URL=https://example.ngrok-free.app

# === Google ===
GOOGLE_SERVICE_ACCOUNT_PATH=./bot/secrets/credentials.json
GOOGLE_SHEET_ID=1tl3rvKeaMrreDfjQMQQPlZF6hGYbG-h0Ft4BroPRw_w
ARCHIVE_FOLDER_ID=1OvuG8ZTHlvF375Oj0GscdtH0nH8iadRU

# === Mode / server ===
# polling = local dev (long polling). webhook = prod (aiohttp on WEB_PORT).
MODE=polling
WEB_HOST=0.0.0.0
WEB_PORT=8080
# Public URL aiogram sets as the Telegram webhook when MODE=webhook.
WEBHOOK_BASE_URL=https://example.fly.dev
# Telegram-side secret used by aiogram's SimpleRequestHandler.
TELEGRAM_WEBHOOK_SECRET=

# === Logging ===
LOG_LEVEL=INFO
