# === Telegram ===
TELEGRAM_BOT_TOKEN=
OWNER_TELEGRAM_CHAT_ID=

# === n8n integration ===
# Full webhook URL printed by the n8n editor when the Webhook node is deployed.
N8N_WEBHOOK_URL=
# Shared secret stored in the n8n "X-Webhook-Secret" credential.
N8N_WEBHOOK_SECRET=
# Token n8n includes when calling back to the FastAPI receiver.
CALLBACK_TOKEN=
# Public base URL n8n calls back on (ngrok in dev, hosting URL in prod).
CALLBACK_BASE_URL=

# === Google ===
GOOGLE_SERVICE_ACCOUNT_PATH=./bot/secrets/credentials.json
GOOGLE_SHEET_ID=
ARCHIVE_FOLDER_ID=

# === Mode / server ===
# polling = local dev (long polling). webhook = prod (aiohttp on WEB_PORT).
MODE=polling
WEB_HOST=0.0.0.0
WEB_PORT=8080
# Public URL aiogram sets as the Telegram webhook when MODE=webhook.
WEBHOOK_BASE_URL=
# Telegram-side secret used by aiogram's SimpleRequestHandler.
TELEGRAM_WEBHOOK_SECRET=

# === Logging ===
LOG_LEVEL=INFO
